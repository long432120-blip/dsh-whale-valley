{
  "version": 2,
  "id": "whale-girl",
  "name": "鯨魚娘",
  "world": {
    "src": "assets/whale-girl-world.png",
    "frameWidth": 98,
    "frameHeight": 123,
    "footY": 121,
    "drawScale": 0.33333,
    "rows": {"down": 0, "left": 1, "right": 2, "up": 3},
    "idle": 0,
    "walk": [1, 0, 2, 3],
    "fps": 7
  },
  "actions": {
    "src": "assets/whale-girl-actions.webp",
    "frameWidth": 106,
    "frameHeight": 134,
    "footY": 132,
    "drawScale": 0.33333,
    "onClick": "wave",
    "clips": {
      "wave": {"row": 0, "frames": [0, 1, 2, 3, 4, 3, 4, 5], "fps": 6},
      "sit": {"row": 1, "frames": [0, 0, 5, 0, 0, 4, 4, 0, 0, 1, 2, 1], "fps": 2, "loop": 0},
      "happy": {"row": 2, "frames": [0, 1, 1, 2, 3, 3, 2, 4, 5], "fps": 8},
      "sleepy": {"row": 3, "frames": [0, 1, 1, 2, 3], "fps": 2, "loop": 3},
      "fluster": {"row": 4, "frames": [0, 1, 1, 2, 3, 4, 4, 5], "fps": 5},
      "tavern_sit": {"row": 0, "frames": [0], "fps": 1, "loop": 0, "sheet": {"src": "assets/whale-girl-tavern-sit.png", "frameWidth": 75, "frameHeight": 132, "footY": 131, "drawScale": 0.33333, "faces": "right"}},
      "swim": {"row": 0, "frames": [0, 1], "fps": 3, "loop": 0, "sheet": {"src": "assets/whale-girl-swim.png", "frameWidth": 89, "frameHeight": 67, "footY": 60, "drawScale": 0.42, "faces": "right"}}
    }
  },
  "player": {"src": "assets/player.png", "frameWidth": 16, "frameHeight": 32, "footY": 31, "rows": {"down": 0, "left": 1, "right": 2, "up": 3}, "idle": 0, "walk": [1, 0, 2, 0], "fps": 6},
  "portrait": {"src": "assets/whale-girl-portrait.webp", "frames": 12, "fps": 8},
  "emotes": {
    "src": "assets/emotes.png",
    "size": 16,
    "names": ["heart", "note", "zzz", "dots", "exclaim"]
  },
  "speed": 2.5,
  "idleMs": [1800, 4500],
  "dialogue": {"charsPerSec": 28, "holdMs": 2600},
  "schedule": {
    "morning": {"scene": "room", "spots": ["window", "plant", "rug"]},
    "afternoon": {"scene": "garden", "spots": ["pond", "flowers", "tree"]},
    "evening": {"scene": "garden", "spots": ["pond", "fence"]},
    "night": {"scene": "room", "spots": ["bed", "table"]}
  },
  "lines": [
    {"text": "咕嚕咕嚕～", "weight": 2},
    {"text": "主人今天想吃魚嗎？"},
    {"text": "噗嚕…吐個泡泡給你看！", "action": "happy"},
    {"text": "摸頭要輕一點喔～", "action": "fluster"},
    {"text": "房間好溫暖，想睡午覺了…", "scenes": ["room"], "action": "sleepy"},
    {"text": "魚缸裡的小橘今天也很有精神！", "scenes": ["room"]},
    {"text": "池塘裡的小魚是我的朋友！", "scenes": ["garden"]},
    {"text": "花開了耶，主人快看！", "scenes": ["garden"], "action": "happy"},
    {"text": "早安，主人！今天也要元氣滿滿～", "phases": ["morning"], "action": "happy"},
    {"text": "呼啊…該睡覺了嗎？", "phases": ["night"], "weight": 2, "action": "sleepy"},
    {"text": "外面的空氣好好～", "on": ["enter"], "scenes": ["garden"], "action": "happy"},
    {"text": "傍晚的池塘最漂亮了…", "on": ["enter"], "scenes": ["garden"], "phases": ["evening"], "weight": 3, "action": "sit"},
    {"text": "回家囉！", "on": ["enter"], "scenes": ["room"], "action": "wave"},
    {"text": "天黑了，回房間準備睡覺～", "on": ["enter"], "scenes": ["room"], "phases": ["night"], "weight": 3},
    {"text": "主人終於回來了！我等好久了～", "on": ["welcome"], "action": "happy"},
    {"text": "跟主人在一起的時候，尾巴會自己搖起來耶～", "minAffection": 50, "weight": 2, "action": "happy"},
    {"text": "主人的手好暖…再摸一下下就好。", "minAffection": 50, "weight": 2, "action": "fluster"},
    {"text": "以前我只會在池塘裡吐泡泡，現在有主人陪我了！", "minAffection": 150, "weight": 2, "action": "happy"},
    {"text": "偷偷告訴你：傍晚的池塘會出現河豚喔。", "minAffection": 150, "weight": 2, "phases": ["afternoon", "evening"]},
    {"text": "這裡就是我的家，因為有主人在。", "minAffection": 330, "weight": 3, "action": "wave"},
    {"text": "不管多晚，我都會等主人回家的。", "minAffection": 330, "weight": 3, "phases": ["evening", "night"], "action": "sit"},
    {"text": "啊嗚！好吃～", "on": ["feed"], "action": "happy"},
    {"text": "謝謝主人，肚子暖暖的～", "on": ["feed"]},
    {"text": "是魚耶！咕嚕咕嚕，一口吞下去！", "on": ["feed"], "categories": ["fish"], "action": "happy"},
    {"text": "新鮮的蔬菜，嚼嚼嚼…", "on": ["feed"], "categories": ["crop"]},
    {"text": "河豚！！最喜歡主人了！", "on": ["feed"], "items": ["fish_puffer"], "action": "fluster"},
    {"text": "草莓好甜～主人也吃一口嘛！", "on": ["feed"], "items": ["crop_strawberry"], "action": "happy"},
    {"text": "紅蘿蔔…聽說吃了眼睛會變好？", "on": ["feed"], "items": ["crop_carrot"]},
    {"text": "嗚…辣辣的…（眼淚汪汪）", "on": ["feed"], "tags": ["disliked"], "action": "fluster"},
    {"text": "嘿嘿，今天已經好開心了，明天再一起吃吧！", "on": ["feed"], "tags": ["capped"]},
    {"text": "吃、吃不下了啦…肚子圓滾滾的。", "on": ["full"], "action": "sleepy"},
    {"text": "我們的關係變成「{level}」了！以後也請多多指教～", "on": ["levelup"], "action": "wave"},
    {"text": "呼…好累，讓我休息一下再釣嘛。", "on": ["tired"], "action": "sleepy"},
    {"text": "種子用完了…去跟旅行商人換一點吧！", "on": ["no_seed"]},
    {"text": "是河豚！今天運氣真好！", "on": ["caught"], "items": ["fish_puffer"], "action": "happy"},
    {"text": "這、這個不能吃吧…", "on": ["caught"], "categories": ["junk"], "action": "fluster"},
    {"text": "豐收啦！", "on": ["harvest"], "action": "happy"},
    {"text": "草莓紅通通的，好想現在就吃～", "on": ["harvest"], "items": ["crop_strawberry"], "action": "happy"},
    {"text": "哇！是沒看過的魚！快記到圖鑑裡～", "on": ["caught"], "tags": ["new"], "action": "happy"},
    {"text": "是主人親手做的料理！好幸福～", "on": ["feed"], "categories": ["dish"], "action": "happy"},
    {"text": "壽司！！我可以吃十盤！", "on": ["feed"], "items": ["food_sushi"], "action": "fluster"},
    {"text": "南瓜圓滾滾的，跟我的肚子一樣。", "on": ["harvest"], "items": ["crop_pumpkin"], "action": "happy"},
    {"text": "今天是{festival}！主人，我們一起去逛逛吧！", "on": ["festival"], "action": "happy"},
    {"text": "{festival}耶～我穿得好看嗎？", "on": ["festival"], "action": "fluster"},
    {"text": "嗚……我、我願意！以後也請多多指教，老公大人！", "on": ["married"], "action": "fluster"},
    {"text": "早安～我已經幫你澆好 {watered} 塊田、摸過動物們了喔！", "on": ["help"], "action": "wave"},
    {"text": "我出發囉！會帶好多亮晶晶的石頭回來！", "on": ["mine_go"], "action": "wave"},
    {"text": "礦洞好暗……不過我不怕！", "on": ["mine_go"]},
    {"text": "我回來了！看，戰利品！", "on": ["mine_back"], "action": "happy"},
    {"text": "嗚……被打得好痛，下次要帶更好的劍……", "on": ["mine_back"], "tags": ["injured"], "action": "sleepy"},
    {"text": "牧場越來越熱鬧了呢！", "scenes": ["ranch"], "action": "happy"},
    {"text": "海風好舒服～", "scenes": ["beach"]},
    {"text": "小鎮的大家都好親切。", "scenes": ["town"]},
    {"text": "溫室裡好暖和，冬天也能種草莓！", "scenes": ["greenhouse"], "action": "happy"},
    {"text": "閣樓的窗戶看得到整片星空。", "scenes": ["attic"]},
    {"text": "最喜歡主人了～今天也辛苦了！", "minAffection": 500, "weight": 2, "action": "fluster"},
    {"text": "哇，是大海！", "on": ["enter"], "scenes": ["beach"], "action": "happy"},
    {"text": "動物們在等我們呢！", "on": ["enter"], "scenes": ["ranch"]},
    {"text": "去小鎮逛逛～", "on": ["enter"], "scenes": ["town"], "action": "wave"}
  ]
}
