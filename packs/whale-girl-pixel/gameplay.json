  "npcs": {
    "barkeep": {
      "name": "老吳",
      "emoji": "🧔",
      "title": "酒館老闆",
      "shop": "tavern",
      "loves": ["food_paella", "fish_lobster", "food_cheese"],
      "likes": ["crop_tomato", "crop_corn", "fish_salmon", "egg"],
      "dislikes": ["junk_can", "junk_boot"],
      "lines": [
        {"text": "來來來，坐！今天的燉飯特別好吃。"},
        {"text": "晚上八點以後，鎮上的人都會來這裡喝一杯。"},
        {"text": "街機猜硬幣？十個金幣一次，猜中拿二十。別玩太多喔～"},
        {"text": "牌桌那邊可以跟大家比大小，贏了大家會更喜歡你。"},
        {"text": "老陳那傢伙每晚都坐同一張高腳椅。", "phases": ["night"]},
        {"text": "你家那位每次來都盯著鬆餅看，哈哈。", "minFriendship": 100},
        {"text": "年輕時我在船上當廚師，跑遍了整片海。後來還是覺得開間小店比較適合我。", "minFriendship": 300}
      ],
      "sprite": "assets/npc/barkeep.png",
      "portrait": "assets/npc/barkeep-big.png"
    },
    "fisher": {
      "name": "老陳",
      "emoji": "🧔",
      "title": "漁夫",
      "loves": ["fish_lobster", "fish_shark", "food_smoked_fish"],
      "likes": ["fish_mackerel", "fish_bass", "fish_salmon", "fish_trout"],
      "dislikes": ["junk_can", "junk_boot"],
      "lines": [
        {"text": "釣魚啊，最重要的是耐心。"},
        {"text": "下雨天去海邊看看，螃蟹會爬出來。"},
        {"text": "晚上的河邊有鰻魚，滑溜溜的，很難抓。", "phases": ["evening", "night"]},
        {"text": "你家那個鯨魚丫頭啊，釣魚的時候眼睛都會發亮。", "minFriendship": 200},
        {"text": "有空常來坐坐，老頭子我一個人也挺悶的。", "minFriendship": 500},
        {"text": "用蚯蚓釣魚，魚咬得比較快；想釣稀有的魚，就用魔法魚餌。"},
        {"text": "傳說湖裡住著一位女神……老頭子我年輕時見過一次。", "minFriendship": 100},
        {"text": "藍色貝殼？那可是求婚用的。海邊偶爾撿得到，我店裡也有一個。", "minFriendship": 300}
      ],
      "events": [
        {
          "id": "fisher-1",
          "minFriendship": 200,
          "lines": ["……你知道這片海為什麼這麼平靜嗎？", "很久以前，有一隻大鯨魚每天晚上在這裡唱歌。", "後來牠變成了人，住進了岸邊的小房子。", "……哈哈，老頭子胡說的。不過，你家那位，跟傳說還真像。"]
        },
        {"id": "fisher-2", "minFriendship": 500, "lines": ["這個給你。", "是我年輕時用的魚線，現在用不到了。", "好好照顧那個丫頭，也照顧好自己。"]}
      ],
      "shops": ["fishmonger", "fisher"],
      "sprite": "assets/npc/fisher.png",
      "portrait": "assets/npc/fisher-big.png"
    },
    "florist": {
      "name": "小葵",
      "emoji": "👧",
      "title": "花店",
      "shop": "florist",
      "loves": ["crop_strawberry", "food_jam", "cloth"],
      "likes": ["crop_carrot", "crop_tomato", "crop_pumpkin", "crop_cabbage", "egg"],
      "dislikes": ["fish_squid", "drop_slime"],
      "lines": [
        {"text": "今天的花開得好漂亮！"},
        {"text": "房間換個壁紙，心情也會跟著變喔。"},
        {"text": "早安！要不要買一盆花回去？", "phases": ["morning"]},
        {"text": "你送的果醬，我每天早上都塗在吐司上！", "minFriendship": 200},
        {"text": "鯨魚娘說她最喜歡你了，我都聽到了喔～", "minFriendship": 400}
      ],
      "events": [
        {"id": "florist-1", "minFriendship": 200, "lines": ["那個……我可以問你一件事嗎？", "鯨魚娘上次來買花，說是要送給「最重要的人」。", "嘻嘻，你猜是誰？"]},
        {
          "id": "florist-2",
          "minFriendship": 500,
          "lines": ["謝謝你一直來看我。", "以前這條街很冷清，你們搬來之後熱鬧多了。", "這是花店的會員卡！……雖然只有你一個會員。"]
        }
      ],
      "sprite": "assets/npc/florist.png",
      "portrait": "assets/npc/florist-big.png",
      "shops": ["petshop"]
    },
    "smith": {
      "name": "阿綱",
      "emoji": "👨‍🔧",
      "title": "鐵匠",
      "shop": "smith",
      "loves": ["gem_diamond", "gem_ruby", "bar_gold"],
      "likes": ["ore_copper", "ore_iron", "ore_gold", "gem_quartz", "gem_amethyst"],
      "dislikes": ["crop_strawberry", "food_jam"],
      "lines": [
        {"text": "礦洞越深越危險，裝備要跟上。"},
        {"text": "銅礦五個煉一塊銅錠。熔爐就在我店旁邊。"},
        {"text": "甜的東西？我不吃。", "minFriendship": 100},
        {"text": "上次你家那位從礦洞回來，渾身是灰還在笑。真有膽量。", "minFriendship": 300}
      ],
      "events": [
        {
          "id": "smith-1",
          "minFriendship": 300,
          "lines": ["……來，看看這個。", "我師父留下的鎚子。", "總有一天，我要打出一把比他更好的劍。", "到時候，第一把給你家那位。"]
        }
      ],
      "sprite": "assets/npc/smith.png",
      "portrait": "assets/npc/smith-big.png"
    }
